+    def test_faster_playback_with_different_input_alignment(self):
+        from animation_modem.progressive import Receiver as ProgressiveReceiver
+        # 1.12x failed before payload decoding. A one-sample source prefix
+        # also checks that this is not a fix for just one resampling phase.
+        for prefix in (0, 1):
+            with self.subTest(prefix=prefix):
+                source = np.concatenate((np.zeros((prefix, 2)), self.audio))
+                audio = resample_poly(source, 25, 28, axis=0)
+                baseline = ProgressiveReceiver(self.layout, self.coder)
+                expected = (baseline.feed(audio)+baseline.flush())[-1]
+                with patch.object(v, '_coarse_bank', side_effect=AssertionError('bank')), \
+                     patch.object(v.Receiver, '_acquire', side_effect=AssertionError('search')), \
+                     patch.object(v, '_fit_sync', side_effect=AssertionError('iterative fit')), \
+                     patch.object(v, 'decode_packet', side_effect=AssertionError('payload replay')):
+                    rx, out = self.collect(audio)
+                self.assertTrue(out)
+                final = out[-1]
+                self.assertTrue(final.extra['complete'])
+                self.assertEqual(final.absolute, 1)
+                self.assertEqual(rx.reference_fits, 1)
+                self.assertEqual(rx.reference_rejections, 0)
+                self.assertEqual(final.extra['fft_symbols'], self.layout.symbols)
+                self.assertAlmostEqual(1/(1+final.rate_error), 1.12, delta=.001)
+                # Verified identity alone is insufficient: retain the older
+                # decoder's image fidelity on exactly the same speed-up audio.
+                error = np.sqrt(np.mean((final.values-self.values)**2))
