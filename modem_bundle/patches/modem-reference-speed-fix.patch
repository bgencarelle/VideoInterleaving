 @lru_cache(maxsize=1)
 def _reference_table():
-    # Single local linearization: gain, fractional delay, dilation. Centering
-    # keeps the tiny normal equation well conditioned. Never iterate/replay.
-    q = np.arange(8, len(v.SYNC)-8, dtype=float)
+    # Edge locations are quantized in input samples. At faster playback that
+    # can be more than one nominal sample: a wideband first-order model then
+    # rejects a valid preamble. Measure its smooth low-band component instead.
+    # One fixed symmetric FIR, shared by the reference and observation, keeps
+    # the same single gain/delay/dilation solve without an iterative fit.
+    taps = np.arange(-16, 17, dtype=float)
+    kernel = np.sinc(.16*taps)*np.hanning(len(taps))
+    kernel /= kernel.sum()
+    q = np.arange(len(v.SYNC), dtype=float)
     derivative = np.fft.irfft(
         np.fft.rfft(v.SYNC)*(2j*np.pi*np.fft.rfftfreq(len(v.SYNC))),
-        n=len(v.SYNC))[8:-8]
-    design = np.stack((v.SYNC[8:-8], derivative,
-                       derivative*(q-q.mean())), axis=1)
+        n=len(v.SYNC))
+    smooth = np.convolve(v.SYNC, kernel, mode='same')[16:-16]
+    slope = np.convolve(derivative, kernel, mode='same')[16:-16]
+    # Apply the same filter to the dilation column, not just to its derivative.
+    stretch = np.convolve(derivative*(q-q.mean()), kernel, mode='same')[16:-16]
+    design = np.stack((smooth, slope, stretch), axis=1)
     gram = np.einsum('ni,nj->ij', design, design, optimize=False)
     projection = np.linalg.solve(gram, design.T)
-    return q, design, projection
+    return q, design, projection, kernel
 
 
